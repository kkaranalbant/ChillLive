       sudo ln -sf /etc/nginx/sites-available/chat-app /etc/nginx/sites-enabled/chat-app

       # Nginx config test
       if sudo nginx -t 2>&1 | grep -q "successful"; then
           echo "   ✅ Nginx config güncellendi"
       else
           echo "   ❌ Nginx config hatası!"
           exit 1
       fi
   else
       echo "   ⚠  nginx.conf bulunamadı"
