# Server Configuration
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas (Production-ready with authentication)
# Get your connection string from: https://cloud.mongodb.com
# Replace <username>, <password>, and <database-name> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database-name>?retryWrites=true&w=majority&appName=YourAppName

# Local MongoDB (Development - no auth, uncomment to use)
# MONGODB_URI=mongodb://localhost:27017/chat-app

# JWT Secrets (Generate secure random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS - Add your frontend URLs
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://your-ngrok-url.ngrok-free.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
